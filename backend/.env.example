# Example environment variables for running RoyanHealth — Royan Hospital in production (sanitized)
# Copy to .env and fill with real secrets before deploying.

# Primary runtime choices
# Prefer `DATABASE_URL` for direct Postgres access (recommended when using local Postgres or a managed Postgres instance)
# Example: postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@db-host:5432/synbot_health?sslmode=require"

# Optional legacy Supabase SDK keys (only required if you intend to use the Supabase REST/Auth APIs)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-supabase-service-role-key"

# LLM / Embedding keys
DEEPSEEK_API_KEY="REPLACE_WITH_KEY"
DEEPSEEK_MODEL="model-name"
HF_API_KEY=""
LLM_PROVIDER=deepseek
HF_API_URL=""
# Optional embedding proxy (e.g., HF Space or local embed service)
EMBED_URL=""

# Email (used for lead notifications + bulk email broadcasts)
# Gmail: create an App Password at myaccount.google.com/apppasswords
EMAIL_FROM="no-reply@royalhospital.com"
EMAIL_PASS="gmail-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Termii — WhatsApp / SMS broadcast (https://termii.com)
TERMII_API_KEY="REPLACE_WITH_TERMII_KEY"
TERMII_SENDER_ID="RoyanHospital"

# Weekly report email scheduler (every Monday 08:00 WAT)
WEEKLY_REPORT_RECIPIENTS="md@royanhospital.com,admin@royanhospital.com"
WEEKLY_REPORT_ENABLED="1"          # set to "0" to disable

# Frontdesk executive notifications (sent after finance approval)
EXECUTIVE_NOTIFY_EMAILS="ceo@royanhospital.com,cfo@royanhospital.com"

# JWT secret used to sign tokens
JWT_SECRET="$(openssl rand -hex 32)"
JWT_AUDIENCE=""

# Superadmin auto-seed credentials (seeded on startup if user doesn't exist)
ADMIN_EMAIL="admin@royanhospital.com"
ADMIN_PASSWORD="change-me-in-production"

# Operational
ENVIRONMENT=production
LOG_LEVEL=INFO
RATE_LIMIT=60
CORS_ALLOW_ORIGINS="https://your-app.example"

# Widget keys (comma-separated allowed origins/public keys)
WIDGET_SITE_KEYS=""

# Webhook secret for provider callbacks
WEBHOOK_SECRET=""

# At-rest encryption key (base64-encoded 16/24/32 bytes). Leave empty to disable.
AT_REST_KEY=""

# Auth0 / OIDC (optional for RS256 JWT verification)
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
AUTH0_ISSUER=""

# Optional feature flags
ENABLE_EXPIRY_MONITOR=0
DEV_TOKEN_ENABLED=0
SAGE_MOCK=1

# Google Places API — Lead Finder (CRM)
# Get a key at https://console.cloud.google.com/ → APIs → Places API
# Leave blank to use built-in mock data (safe for dev/demo)
GOOGLE_PLACES_API_KEY=

# Agent / event bus configuration
# Postgres listen channel used by background agents (kept as default 'event_bus')
PG_EVENT_CHANNEL=event_bus

# Production defaults and environment
ENVIRONMENT=production
LOG_LEVEL=INFO
RATE_LIMIT=60
CORS_ALLOW_ORIGINS="https://your-app.example"

# ---------------------------------------------------------------------------
# Hope Bridge — DRM Hope integration (see hope-bridge/ at repo root)
# ---------------------------------------------------------------------------
# LAN IP of the Windows PC running DRM Hope + the bridge service.
# Set to http://localhost:7070 during local dev with HOPE_MOCK=1.
HOPE_BRIDGE_URL="http://192.168.1.<HOPE_PC_IP>:7070"

# Shared HMAC secret — must match the value in hope-bridge/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HOPE_BRIDGE_KEY="REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET"

# Separate secret for inbound webhooks pushed from the bridge
HOPE_BRIDGE_WEBHOOK_SECRET="REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_SECRET"

# Set to 1 during development — all bridge routes return static sample data.
# Switch to 0 after the first site visit and ODBC/API is confirmed working.
HOPE_MOCK=1

# ---------------------------------------------------------------------------
# Monitoring (Grafana — loopback only, never expose to public)
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
