# PostgreSQL connection for the local RoyanHealth Docker instance
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres

# Optional: path to the SQLite staging file (default: staging/hope_staging.db)
# STAGING_DB_PATH=staging/hope_staging.db

# Pipeline v2 settings
# REDIS_URL=redis://localhost:6379/0
# PIPELINE_MAX_WORKERS=4
# PIPELINE_MODE=full
# LOG_FORMAT=console
