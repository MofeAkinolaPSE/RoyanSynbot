# Hope Bridge .env
# Copy to .env and fill in before running on the Hope PC.

# Shared secret — must match HOPE_BRIDGE_KEY in the SynHealth backend .env
BRIDGE_API_KEY=REPLACE_WITH_SAME_32_CHAR_SECRET_AS_HOPE_BRIDGE_KEY

# Shared secret for outbound webhook calls to the backend
SYNHEALTH_WEBHOOK_SECRET=REPLACE_WITH_SAME_VALUE_AS_HOPE_BRIDGE_WEBHOOK_SECRET

# URL of the SynHealth backend (reachable from the Hope PC on the LAN)
SYNHEALTH_BACKEND_URL=http://192.168.1.<SERVER_IP>:8000

# DRM Hope ODBC DSN — registered in Windows ODBC Data Source Administrator
# Open: Control Panel → Administrative Tools → ODBC Data Sources (64-bit)
HOPE_ODBC_DSN=HopeDSN

# Set to 1 during development to return mock data without an ODBC connection
HOPE_MOCK=1
