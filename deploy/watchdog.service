[Unit]
Description=Royan Hospital Stack Watchdog
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStart=/opt/royan/deploy/watchdog.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=royan-watchdog

[Install]
WantedBy=multi-user.target
