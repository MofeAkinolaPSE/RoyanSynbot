[Unit]
Description=Royan Hospital — Daily PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Source env to get POSTGRES_* vars
EnvironmentFile=/opt/royan/deploy/.env
ExecStart=/bin/sh -c '\
    TIMESTAMP=$(date +%%Y%%m%%d_%%H%%M%%S); \
    FILENAME="/opt/royan/backups/royan_${TIMESTAMP}.sql.gz"; \
    mkdir -p /opt/royan/backups; \
    docker exec royan_db.1.$(docker service ps -q royan_db | head -1) \
        pg_dump -U "${POSTGRES_USER}" "${POSTGRES_DB}" | gzip > "${FILENAME}" && \
    ln -sf "${FILENAME}" /opt/royan/backups/latest.sql.gz && \
    find /opt/royan/backups -name "royan_*.sql.gz" -mtime +30 -delete && \
    echo "Backup complete: ${FILENAME}"'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=royan-backup

[Install]
WantedBy=multi-user.target
