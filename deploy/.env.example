# ─── Royan Hospital — Environment Template ────────────────────────────────
# Copy to .env and fill in real values before running docker compose up.
# NEVER commit .env to git.
#
# ALL variables below are also required as GitHub Secrets in:
#   GitHub → repo → Settings → Secrets and variables → Actions

# ── Database ──────────────────────────────────────────────────────────────
# Full connection string (preferred). Constructed from POSTGRES_* in CI/CD.
DATABASE_URL=postgresql://royan:CHANGE_THIS@db:5432/royan_hospital
POSTGRES_USER=royan
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=royan_hospital
POSTGRES_HOST=db

# ── Supabase (optional — only if using Supabase SDK features) ─────────────
SUPABASE_URL=http://db:5432
SUPABASE_KEY=your_supabase_service_role_key

# ── JWT Auth ───────────────────────────────────────────────────────────────
# CRITICAL: Generate ONCE and never change after first deploy.
# Changing JWT_SECRET invalidates every active session for all users immediately.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING_THEN_NEVER_TOUCH_IT_AGAIN
JWT_AUDIENCE=
ACCESS_TOKEN_MINUTES=45
REFRESH_TOKEN_DAYS=7

# ── Auth0 (optional — activates RS256 token validation alongside local JWT) ──
# When set, the backend accepts BOTH local JWTs (from /token) AND Auth0 JWTs.
# Leave blank to use local JWT only (default).
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://synbothealth.api

# ── LLM (DeepSeek) ────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
LLM_PROVIDER=deepseek

# ── Email — Gmail App Password ─────────────────────────────────────────────
# Create App Password at: myaccount.google.com/apppasswords
EMAIL_FROM=no-reply@royanhospital.com
EMAIL_PASS=gmail-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── SMS — Termii (WhatsApp / SMS broadcast) ────────────────────────────────
# Create account at: termii.com
TERMII_API_KEY=REPLACE_WITH_TERMII_KEY
TERMII_SENDER_ID=RoyanHospital

# ── Notification recipients ────────────────────────────────────────────────
WEEKLY_REPORT_RECIPIENTS=md@royanhospital.com,admin@royanhospital.com
WEEKLY_REPORT_ENABLED=1
EXECUTIVE_NOTIFY_EMAILS=ceo@royanhospital.com,cfo@royanhospital.com

# ── Payments ───────────────────────────────────────────────────────────────
# Leave blank to run in stub/test mode (no real charges)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ── SMS fallback — Africa's Talking ───────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox

# ── PACS Integration ───────────────────────────────────────────────────────
PACS_BASE_URL=
PACS_API_KEY=

# ── Hope Bridge (DRM Hope legacy HMS) ─────────────────────────────────────
HOPE_BRIDGE_URL=http://host.docker.internal:7070
HOPE_BRIDGE_KEY=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
HOPE_BRIDGE_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_SECRET
HOPE_MOCK=1

# ── Security ──────────────────────────────────────────────────────────────
# HMAC-SHA256 secret for verifying inbound webhook callbacks
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
# AES-256 at-rest encryption key (base64-encoded 32 bytes). Leave blank to disable.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AT_REST_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NEVER use * in production.
CORS_ALLOW_ORIGINS=https://your-hospital-domain.ng,https://portal.your-hospital-domain.ng

# ── Patient Portal ─────────────────────────────────────────────────────────
PORTAL_TOKEN_EXPIRE_HOURS=24

# ── Redis Cache ────────────────────────────────────────────────────────────
# No credentials needed — Redis runs inside royan_net (not exposed externally).
# This value is set automatically by docker-compose; only override if using an
# external Redis instance (e.g. ElastiCache) with auth: redis://:password@host:6379/0
# REDIS_URL=redis://redis:6379/0

# ── Environment / Feature flags ────────────────────────────────────────────
ENVIRONMENT=production
DEV_TOKEN_ENABLED=0
SAGE_MOCK=0
KNOWLEDGE_REWRITE_ENABLED=0
KNOWLEDGE_RERANK_ENABLED=0

# ── Deployment / Swarm ────────────────────────────────────────────────────
IMAGE_TAG=latest
DOMAIN=your-hospital-domain.ng
PORT=8000

# ── Admin account (seeded on first startup) ───────────────────────────────
ADMIN_EMAIL=admin@royalhospital.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ════════════════════════════════════════════════════════════════════════════
# GitHub Actions Secrets (CI/CD only — not needed locally)
# ════════════════════════════════════════════════════════════════════════════
# Every variable above must also be added as a GitHub Secret.
# These additional variables are needed ONLY for the CI/CD pipeline:
#
# DEPLOY_HOST    — server IP or hostname (e.g. 192.168.1.100)
DEPLOY_HOST=YOUR_SERVER_IP_OR_HOSTNAME
# DEPLOY_USER    — SSH username on server (must have docker access)
DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY — full PEM private key (-----BEGIN ... PRIVATE KEY-----)
DEPLOY_SSH_KEY=-----BEGIN_OPENSSH_PRIVATE_KEY-----
# DEPLOY_PORT    — SSH port (default 22)
DEPLOY_PORT=22
